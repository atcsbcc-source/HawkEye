# Supabase project settings → API (https only)
SUPABASE_URL=https://your-project.supabase.co
# Service role key — pipeline writes bypass RLS. Never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: dashboard base URL. When set, run_pipeline.py fires the automation
# engine (POST /api/automation/evaluate) after each scan upsert.
# Must be https:// (the dashboard rejects http and the token would leak in clear).
DASHBOARD_URL=

# Shared secret sent as `Authorization: Bearer ...` on that call. Must match the
# dashboard's HAWKEYE_PIPELINE_TOKEN (>= 32 chars, e.g. `openssl rand -hex 32`).
HAWKEYE_PIPELINE_TOKEN=
