# Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
# Service role key — pipeline writes bypass RLS. Never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: dashboard base URL. When set, run_pipeline.py fires the automation
# engine (POST /api/automation/evaluate) after each scan upsert.
DASHBOARD_URL=
