# Supabase project settings → API. Without these the dashboard runs on mock data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: used by the dispatch API route to update lead status.
SUPABASE_SERVICE_ROLE_KEY=

# CRM endpoint hit when an operator confirms a lead (e.g. Zapier/Make/GoHighLevel).
CRM_WEBHOOK_URL=
