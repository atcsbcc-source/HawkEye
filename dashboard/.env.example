# ---------------------------------------------------------------------------
# HawkEye dashboard environment
#
# DEV MODE: leave NEXT_PUBLIC_SUPABASE_URL unset and the console runs with mock
# data and NO authentication (an amber "DEV MODE" badge is shown). Production
# builds refuse to start in DEV MODE unless HAWKEYE_ALLOW_DEV_MODE=1.
# ---------------------------------------------------------------------------

# Supabase project settings → API. Must be https://<ref>.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (route handlers): privileged writes, dispatch, automation.
# NEVER prefix this with NEXT_PUBLIC_ — it would ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# CRM endpoint hit when an operator confirms a lead (Zapier/Make/GoHighLevel).
# https only, public host, no credentials in the URL. Validated at boot.
CRM_WEBHOOK_URL=

# Shared secret the CV pipeline sends as `Authorization: Bearer ...` to
# POST /api/automation/evaluate. >= 32 chars; same value in pipeline/.env.
#   openssl rand -hex 32
HAWKEYE_PIPELINE_TOKEN=

# Bearer token for the scheduled /api/automation/sweep route. Vercel Cron sends
# it automatically when set as an env var. >= 16 chars.
CRON_SECRET=

# Optional: HMAC-SHA256 key for outbound webhooks. When set, every webhook POST
# carries x-hawkeye-timestamp and x-hawkeye-signature = hex(HMAC(secret, `${ts}.${body}`)).
WEBHOOK_SIGNING_SECRET=

# Optional: comma-separated hostnames (exact or suffix match) that webhooks may
# target, e.g. "hooks.zapier.com,hook.us1.make.com". Empty = any public https host.
WEBHOOK_ALLOWED_HOSTS=

# Set to 1 ONLY behind a trusted reverse proxy / platform (Vercel, nginx) so
# the first x-forwarded-for hop is used for rate limiting and CSRF host checks.
TRUST_PROXY=0

# Set to 1 to allow a production build to run without Supabase (mock console,
# no auth). Never do this on an internet-facing host.
HAWKEYE_ALLOW_DEV_MODE=0

# Optional: IANA time zone used for every date/time rendered in the console
# (lib/format.ts). Defaults to America/New_York.
NEXT_PUBLIC_OPS_TZ=America/New_York

# ---------------------------------------------------------------------------
# Supabase dashboard settings to flip (Authentication):
#   - Sign In / Providers → Email ON; "Allow new users to sign up" OFF (invite-only)
#   - Passwords → leaked-password protection ON, minimum length 12
#   - URL Configuration → Site URL = deployed origin;
#                          Redirect URLs += <origin>/auth/confirm
#   - Email templates (Invite, Reset password) → link:
#       {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type={{ .Type }}
#   - Rate limits / CAPTCHA as desired
# Invite operators with: npx tsx scripts/invite-user.ts <email> [operator|admin]
# (needs SITE_URL=<deployed origin> in addition to the keys above).
# ---------------------------------------------------------------------------
